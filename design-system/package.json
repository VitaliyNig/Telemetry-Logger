{
  "name": "@telemetry-logger/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Component library extracted from the Telemetry Logger web UI.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/styles.css",
    "src/tokens.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && esbuild src/styles.css --bundle --outfile=dist/styles.css --loader:.css=css",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/react-vite": "^8.6.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
